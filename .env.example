# Firebase configuration
# These are provided by the set_up_firebase tool
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Gemini API Key
# Do NOT prefix with VITE_ to keep it server-side if using full-stack,
# but the gemini-api skill says to use process.env.GEMINI_API_KEY in frontend.
GEMINI_API_KEY=

# Google OAuth (for GBP and Analytics)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
